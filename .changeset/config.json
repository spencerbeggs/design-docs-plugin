{
	"$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
	"access": "restricted",
	"baseBranch": "main",
	"changelog": [
		"@savvy-web/changelog",
		{
			"packages": {
				"design-docs": {
					"versionFiles": [
						{
							"glob": "plugin/.claude-plugin/plugin.json",
							"paths": ["$.version"]
						}
					]
				}
			},
			"repo": "spencerbeggs/design-docs-plugin"
		}
	],
	"commit": false,
	"ignore": [],
	"privatePackages": {
		"tag": true,
		"version": true
	},
	"updateInternalDependencies": "patch"
}
