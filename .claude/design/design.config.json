{
	"$schema": "https://raw.githubusercontent.com/spencerbeggs/design-docs-plugin/main/design-docs.schema.json",
	"integration": {
		"ci": {
			"enabled": false,
			"syncOnMerge": false,
			"validateOnPR": false
		},
		"git": {
			"requireReviewForChanges": false,
			"trackDesignDocs": true
		},
		"plans": {
			"autoSyncProgress": false,
			"bidirectionalLinking": true,
			"cacheMetadata": true,
			"cacheTTL": 300,
			"enabled": true,
			"validateOnCommit": true
		}
	},
	"modules": {
		"design-docs-plugin": {
			"categories": ["architecture", "meta", "documentation"],
			"designDocsPath": ".claude/design/design-docs-plugin",
			"maintainer": "C. Spencer Beggs",
			"path": "plugin",
			"userDocs": {
				"readme": "README.md",
				"repoDocs": "docs",
				"siteDocs": null
			}
		}
	},
	"paths": {
		"context": "CLAUDE.md",
		"designDocs": ".claude/design",
		"localContext": "CLAUDE.local.md",
		"plans": ".claude/plans",
		"skills": "plugin/skills"
	},
	"project": {
		"maintainer": "C. Spencer Beggs",
		"name": "spencerbeggs/design-docs-plugin",
		"repository": "https://github.com/spencerbeggs/design-docs-plugin",
		"type": "monorepo"
	},
	"quality": {
		"context": {
			"childMaxWords": 1000,
			"requireDesignDocPointers": true,
			"rootMaxWords": 2000
		},
		"designDocs": {
			"minSections": ["Overview", "Current State", "Rationale"],
			"requireFrontmatter": true,
			"requireTOC": true
		},
		"plans": {
			"archiveAfterDays": 30,
			"maxLineLength": 120,
			"progressRange": [0, 100],
			"requiredFields": ["name", "title", "created", "status", "progress"],
			"requireFrontmatter": true,
			"stalenessThresholdDays": 30,
			"validStatuses": ["ready", "in-progress", "blocked", "completed", "abandoned"]
		},
		"userDocs": {
			"level1": {
				"maxLineLength": 80,
				"requireSections": ["Features", "Installation", "Usage"],
				"targetWordCount": [200, 500]
			}
		}
	},
	"skills": {
		"baseNamespace": "/",
		"enabled": [
			"design-init",
			"design-validate",
			"design-update",
			"design-sync",
			"design-review",
			"design-audit",
			"design-search",
			"design-compare",
			"design-link",
			"design-index",
			"design-report",
			"design-export",
			"design-archive",
			"design-prune",
			"design-config",
			"plan-create",
			"plan-validate",
			"plan-list",
			"plan-explore",
			"plan-complete",
			"context-validate",
			"context-audit",
			"context-review",
			"context-update",
			"context-split",
			"user-docs-create-readme",
			"docs-generate-repo",
			"docs-generate-site",
			"docs-generate-contributing",
			"docs-generate-security",
			"user-docs-review",
			"docs-review-package",
			"docs-sync",
			"docs-update",
			"finalize"
		]
	},
	"subagents": {
		"context-doc-agent": {
			"description": "Maintain CLAUDE.md context files",
			"enabled": true,
			"file": "plugin/agents/context-doc-agent.md",
			"skills": ["context-validate", "context-audit", "context-review", "context-update", "context-split"],
			"tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"]
		},
		"design-doc-agent": {
			"description": "Maintain internal design documentation and implementation plans",
			"enabled": true,
			"file": "plugin/agents/design-doc-agent.md",
			"skills": [
				"design-init",
				"design-validate",
				"design-update",
				"design-sync",
				"design-prune",
				"design-review",
				"design-audit",
				"design-search",
				"design-index",
				"design-export",
				"design-compare",
				"design-link",
				"design-report",
				"design-archive",
				"design-config",
				"plan-validate",
				"plan-create",
				"plan-list"
			],
			"tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"]
		},
		"user-docs": {
			"description": "Generate user-facing documentation from design docs",
			"enabled": true,
			"file": "plugin/agents/user-docs.md",
			"skills": [
				"user-docs-create-readme",
				"docs-generate-contributing",
				"docs-generate-security",
				"docs-generate-repo",
				"docs-generate-site",
				"docs-sync",
				"user-docs-review",
				"docs-review-package",
				"docs-update"
			],
			"tools": ["Read", "Grep", "Glob", "Edit", "Write"]
		}
	},
	"version": "1.0.0"
}
